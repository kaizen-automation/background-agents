{
  "deployment_name": "kaizen",
  "app_name": "Kaizen Code",
  "harness_allowlist": ["opencode"],
  "model_allowlist": [
    "anthropic/claude-sonnet-4-6",
    "anthropic/claude-opus-4-7",
    "anthropic/claude-sonnet-5",
    "azure/gpt-6-astra",
    "azure/gpt-5.6-sol",
    "azure/gpt-5.6-terra",
    "azure/gpt-6-sol",
    "azure/gpt-6-luna"
